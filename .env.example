# NATS
NATS_URL=nats://localhost:4222

# Simulator
CANDLE_INTERVAL_SECONDS=2
TICKS_PER_CANDLE=5
SIM_RANDOM_SEED=
SIMULATOR_HTTP_PORT=8082

# Go Gateway
HTTP_PORT=8080
PRICE_CHANGE_THRESHOLD_PCT=3.0
VOLUME_RATIO_THRESHOLD=5.0
CRITICAL_PRICE_CHANGE_PCT=5.0
DEBOUNCE_WINDOW_SECONDS=30
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL (TimescaleDB)
POSTGRES_USER=equisentinel
POSTGRES_PASSWORD=equisentinel
POSTGRES_DB=equisentinel

# AI Worker
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=equisentinel
AI_WORKER_HTTP_PORT=8081

# Dashboard
VITE_GATEWAY_WS_URL=ws://localhost:8080/ws
GATEWAY_HTTP_URL=http://localhost:8080

NATS_URL=nats://localhost:4222

# Detik wall-clock antar candle yang dipublish per ticker (disimulasikan dipercepat).
CANDLE_INTERVAL_SECONDS=2
# Jumlah sub-tick GBM yang diagregasi menjadi satu candle OHLCV.
TICKS_PER_CANDLE=5
# Kosongkan untuk random seed non-deterministik; isi angka untuk run yang reproducible.
SIM_RANDOM_SEED=
